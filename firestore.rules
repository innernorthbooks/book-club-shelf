rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS to the Google account you will use for admin sign-in.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'REPLACE_WITH_YOUR_GOOGLE_EMAIL';
    }

    function validShelfCreate() {
      return request.resource.data.keys().hasOnly([
          'title', 'author', 'cover', 'openLibraryKey',
          'comment', 'sharedBy', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 300
        && request.resource.data.cover is string
        && request.resource.data.cover.size() <= 1000
        && request.resource.data.openLibraryKey is string
        && request.resource.data.openLibraryKey.size() <= 300
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.sharedBy is string
        && request.resource.data.sharedBy.size() > 0
        && request.resource.data.sharedBy.size() <= 80
        && request.resource.data.createdAt is timestamp;
    }

    function validScheduleCreate() {
      return request.resource.data.keys().hasOnly([
          'title', 'author', 'cover', 'openLibraryKey',
          'date', 'pickedBy', 'note', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 300
        && request.resource.data.cover is string
        && request.resource.data.cover.size() <= 1000
        && request.resource.data.openLibraryKey is string
        && request.resource.data.openLibraryKey.size() <= 300
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.pickedBy is string
        && request.resource.data.pickedBy.size() > 0
        && request.resource.data.pickedBy.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && request.resource.data.createdAt is timestamp;
    }

    match /shelf/{bookId} {
      allow read: if true;
      allow create: if validShelfCreate();
      allow update, delete: if isAdmin();
    }

    match /schedule/{entryId} {
      allow read: if true;
      allow create: if validScheduleCreate();
      allow update, delete: if isAdmin();
    }

    // Everything else is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
